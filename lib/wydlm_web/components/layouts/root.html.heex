<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content="Free Wyoming driver license practice test — 144 questions from the official Rules of the Road manual, with instant feedback and a 25-question mock exam."
    />
    <meta name="posthog-key" content={posthog_key()} />
    <meta name="posthog-host" content={posthog_host()} />
    <link rel="canonical" href="https://wyodriverlicense.app/" />
    <script type="application/ld+json" phx-no-curly-interpolation>
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Wyoming Driver License Practice Test",
        "url": "https://wyodriverlicense.app/",
        "description": "Free practice questions for the Wyoming driver license written test, drawn from the official Rules of the Road manual.",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "Any",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      }
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Driver Test" />
    <meta property="og:title" content="Wyoming Driver License Practice Test" />
    <meta
      property="og:description"
      content="Free practice questions for the Wyoming driver license written test, drawn from the official Rules of the Road manual."
    />
    <meta property="og:url" content="https://wyodriverlicense.app/" />
    <meta property="og:image" content="https://wyodriverlicense.app/images/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wyoming driver license practice test" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Wyoming Driver License Practice Test" />
    <meta
      name="twitter:description"
      content="Free practice questions for the Wyoming driver license written test, drawn from the official Rules of the Road manual."
    />
    <meta name="twitter:image" content="https://wyodriverlicense.app/images/og-image.png" />
    <meta name="theme-color" content="#3a2417" />
    <link rel="icon" href={~p"/images/icon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/images/icon-180.png"} />
    <.live_title default="Wyoming Driver License Practice Test">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"} />
  </head>
  <body>
    <ul class="menu menu-horizontal w-full relative z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
      <%= if @current_scope do %>
        <li>
          {@current_scope.user.email}
        </li>
        <li>
          <.link href={~p"/users/settings"}>Settings</.link>
        </li>
        <li>
          <.link href={~p"/users/log-out"} method="delete">Log out</.link>
        </li>
      <% else %>
        <li>
          <.link href={~p"/users/register"}>Register</.link>
        </li>
        <li>
          <.link href={~p"/users/log-in"}>Log in</.link>
        </li>
      <% end %>
    </ul>
    {@inner_content}
  </body>
</html>
