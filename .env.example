# Production secrets and configuration. Set these in your environment
# (e.g. `fly secrets set KEY=value`) rather than committing them.

# Required in production. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Public host (used for canonical URLs and routing).
PHX_HOST=wyodriverlicense.app

# SQLite database file. On Fly.io this lives on the mounted /data volume.
DATABASE_PATH=/data/wydlm.db

# Optional browser analytics. Leave unset to disable PostHog entirely.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional Litestream backup target (S3/B2/etc). Leave unset to disable
# continuous backups. Example: s3://bucket-name/path
LITESTREAM_REPLICA_URL=
