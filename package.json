{
  "name": "wydlm",
  "version": "1.0.0",
  "private": true,
  "description": "State driver license practice tests (Elm)",
  "scripts": {
    "prebuild": "node scripts/gen-banks.js",
    "build": "elm make src/Main.elm --optimize --output=public/elm.js",
    "pretest": "node scripts/gen-banks.js",
    "test": "elm-test",
    "dev": "npm run build && npx --yes serve public",
    "format": "elm-format src tests --yes",
    "validate": "elm-format src tests --validate"
  },
  "devDependencies": {
    "elm": "0.19.2-0",
    "elm-format": "0.8.8",
    "elm-test": "0.19.2-1"
  },
  "engines": {
    "node": ">=18"
  }
}
